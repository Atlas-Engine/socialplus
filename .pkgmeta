package-as: SocialPlus

# Use CHANGELOG.md as the changelog instead of letting the packager generate one.
#
# Without this, CurseForge builds the changelog itself from the git commits
# between tags -- the "lightweight tag <sha> / commit / commit / commit" dump.
# It does NOT read the GitHub Release body: publishing notes there, whether
# seconds after the tag or created atomically with it, made no difference to
# what CurseForge displayed. This setting is the only thing that replaces that
# generated text.
#
# markup-type matters too: the notes were previously shown unrendered, so
# Markdown syntax appeared literally. Declaring it tells CurseForge how to
# render the file rather than leaving it to guess.
#
# It points at CHANGELOG-RELEASE.md, which the release workflow regenerates on
# every release to hold ONLY that version's entries plus the "View all
# changelogs" link. Pointing it at CHANGELOG.md instead would dump the entire
# history onto the CurseForge page.
#
# CHANGELOG-RELEASE.md must therefore stay out of the ignore list below -- the
# packager has to be able to read it.
manual-changelog:
  filename: CHANGELOG-RELEASE.md
  markup-type: markdown

ignore:
  - README.md
  - CHANGELOG.md
  - LICENSE
  - .git
  - .gitignore
  - .github
